<script language="JavaScript">
<!-- hide me
var agt=navigator.userAgent.toLowerCase()
this.dream   = (agt.indexOf("dream")!=-1)


function popupSS(url) {
	if ( this.dream ) {
		window.location=url; return false;
	} else {		
		remote = window.open("","utilitywindow","left=15,top=15,width=340,height=320");
		remote.location.href = url;
		remote.focus();
			if (remote.opener == null) remote.opener = window;
	}
}

function popupAds(url) {
	if ( this.dream ) {
		window.location=url; return false;
	} else {		
		remote = window.open("","adswindow","left=15,top=15,width=790,height=535");
		remote.location.href = url;
		remote.focus();
			if (remote.opener == null) remote.opener = window;
	}
}

function popupVault(url) {
	if ( this.dream ) {
		window.location=url; return false;
	} else {		
		remote = window.open("","vaultwindow","left=15,top=15,width=500,height=400");
		remote.location.href = url;
		remote.focus();
			if (remote.opener == null) remote.opener = window;
	}
}


function popupWindow(url,w,h) {
	if ( this.dream ) {
		window.location=url; return false;
	} else {		
		remote = window.open("","popupwindow","left=15,top=15,width=340,height=320");
		remote.location.href = url;
		remote.focus();
		remote.resizeTo( w,h );
			if (remote.opener == null) remote.opener = window;
	}
}

       function popupNoSize(w,h,name,URL) {

        newWin = window.open(URL,name,"width=" + w + ",height=" + h);

        newWin.focus();

	
}

//-->
</script>


</head>

